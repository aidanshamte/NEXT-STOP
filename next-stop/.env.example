# Optional starting address; the installed app can configure and save it itself.
EXPO_PUBLIC_API_URL=
# Set to 1 only when building for trusted local-network testing.
ALLOW_LOCAL_HTTP=1
# Restrict Android Maps SDK key to your package and signing certificate.
GOOGLE_MAPS_ANDROID_API_KEY=

# If EAS prompts you to link a project, copy its returned ID here and into
# the selected Expo build environment. Do not invent a project ID.
EAS_PROJECT_ID=
