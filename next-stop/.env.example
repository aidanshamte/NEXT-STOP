# PUBLIC APP CONFIGURATION (bundled into the app, never put secrets here)
# Optional for Expo development: uses the Expo computer hostname + API port 4000.
# Required for installed/production apps: your actual hosted HTTPS API origin.
EXPO_PUBLIC_API_URL=
# Public Google OAuth client IDs, not client secrets.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# SERVER-ONLY EMAIL CONFIGURATION. Required for actual verification/reset emails.
# Use your email provider's SMTP credentials and an approved sender address.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# SERVER-ONLY GOOGLE TOKEN VALIDATION
# Web OAuth client ID used by GIS and as audience for native sign-in tokens.
GOOGLE_WEB_CLIENT_ID=
# Optional comma-separated additional allowed OAuth token audiences.
GOOGLE_CLIENT_IDS=

# NATIVE BUILD CONFIGURATION
ALLOW_LOCAL_HTTP=0
# Optional: derived from EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID when omitted.
GOOGLE_IOS_URL_SCHEME=
EAS_PROJECT_ID=
