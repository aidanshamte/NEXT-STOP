[Unit]
Description=NEXT STOP API and realtime server
After=network-online.target var-lib-next\x2dstop.mount
Wants=network-online.target
RequiresMountsFor=/var/lib/next-stop

[Service]
Type=simple
User=nextstop
Group=nextstop
WorkingDirectory=/opt/next-stop/current
# Secrets (SMTP password, Google client IDs) live only on the server, never in Git.
EnvironmentFile=/etc/next-stop/next-stop.env
# Written by release.sh: RELEASE_ID=<git sha>
EnvironmentFile=/opt/next-stop/current/release.env
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=4000
Environment=TRUST_PROXY=1
# Trip notifications through Expo Push Service.
Environment=PUSH_ENABLED=1
Environment=DATABASE_PATH=/var/lib/next-stop/next-stop.db
ExecStart=/usr/bin/node server/index.mjs
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
MemoryMax=600M

# Hardening: the process can write only to its data directory.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/next-stop

[Install]
WantedBy=multi-user.target
