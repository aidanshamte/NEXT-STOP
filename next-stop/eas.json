{
  "cli": {
    "version": ">=16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "ALLOW_LOCAL_HTTP": "1"
      }
    },
    "local-network": {
      "distribution": "internal",
      "env": {
        "ALLOW_LOCAL_HTTP": "1"
      },
      "android": {
        "buildType": "apk"
      },
      "environment": "preview"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "ALLOW_LOCAL_HTTP": "0"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "ALLOW_LOCAL_HTTP": "0"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
